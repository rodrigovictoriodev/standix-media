NODE_ENV=development

POSTGRES_DB=standix_media
POSTGRES_USER=standix
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://standix:change-me@postgres:5432/standix_media?schema=public

REDIS_URL=redis://redis:6379

MINIO_ROOT_USER=standix
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=standix-media
MINIO_ACCESS_KEY=standix
MINIO_SECRET_KEY=change-this-minio-password

JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SOCKET_URL=/events
MINIO_PUBLIC_URL=http://localhost:8081
NGINX_HTTP_BIND_IP=0.0.0.0
NGINX_HTTP_PORT=8081
WEB_ORIGIN=http://localhost:8081
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
