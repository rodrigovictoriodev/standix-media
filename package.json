{
  "name": "standix-media",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "branding:generate": "node scripts/generate-brand-assets.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml,css,prisma}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml,css,prisma}\""
  },
  "devDependencies": {
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "sharp": "^0.35.5",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "prisma"
    ]
  }
}
